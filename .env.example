# scripts/setup-local.sh creates a unique local token. Never commit the real .env.
DOCTOR_API_TOKEN=
# Optional for plans/repairs; repository context is sent to Groq when configured.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional, fine-grained access to the specific repository for publication.
GITHUB_TOKEN=
DOCTOR_SANDBOX_IMAGE=codebase-doctor-sandbox:local
# Defaults to backend/data under native development.
# DOCTOR_DATA_DIR=/absolute/private/path
